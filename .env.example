# =====================================================================
# Riburaju Family Budget — Environment Variables
# Copy this file to ".env.local" for local development.
# In production (Vercel), set these in Project Settings → Environment
# Variables instead of committing a real .env file.
# NEVER commit an actual .env / .env.local file with real values.
# =====================================================================

# --- Supabase (public — safe to expose to the browser) ---------------
# Found in Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase (secret — server only, NEVER expose to the browser) ----
# Used only in server-side route handlers (invites, admin actions).
# Do not prefix with NEXT_PUBLIC_. Do not import in client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application -------------------------------------------------------
# Public base URL of the deployed app, used for building email links
# (password reset, invite links). No trailing slash.
NEXT_PUBLIC_APP_URL=https://riburaju.com

# Name shown in the UI and emails
NEXT_PUBLIC_APP_NAME="Riburaju Family Budget"

# Default currency (ISO 4217). Structure supports switching later.
NEXT_PUBLIC_DEFAULT_CURRENCY=AED

# --- Family invite bootstrap --------------------------------------------
# A long random secret used ONLY once, by the setup script / first-run
# admin invite route, to create the very first admin + family record.
# Generate with: openssl rand -hex 32
# Remove/rotate this after the first admin account is created.
ADMIN_BOOTSTRAP_SECRET=change-this-to-a-long-random-value

# --- Recurring transactions & notifications cron ------------------------
# Bearer token that Vercel Cron must send to authorize daily calls to
# /api/cron/recurring (generates due recurring transactions + notifications).
# Generate with: openssl rand -hex 32
CRON_SECRET=change-this-to-a-different-long-random-value
